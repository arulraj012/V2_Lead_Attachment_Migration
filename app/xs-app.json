{
  "welcomeFile": "/v2leadattachmentmigration/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/migration/(.*)$",
      "target": "/migration/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/v2leadattachmentmigration/(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
